From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 27 Oct 2026 21:17:01 +0000
Subject: [PATCH 8/8] Export all bindings and the version from the pysubj
 package

__version__ was listed in __all__ but not imported, as star imports
skip names with a leading underscore, so pysubj.__version__ raised an
AttributeError. Also list Histogram, normalMultiplication and
deduction in __all__.
---
 src/pysubj/__init__.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/pysubj/__init__.py b/src/pysubj/__init__.py
index 27d8f4d..657acc9 100644
--- a/src/pysubj/__init__.py
+++ b/src/pysubj/__init__.py
@@ -7,5 +7,6 @@ a subjective logic library written in C++.
 '''
 
 from .pysubj import *
+from .pysubj import __version__
 
-__all__ = ("__doc__", "__version__", "OpinionOwner", "DirichletPDF", "MultinomialOpinion", "BinomialOpinion", "projectedDistance", "pd", "conjunctiveCertainty", "cc", "degreeOfConflict", "doc", "averagingBeliefFusion", "abf", "aleatoryCumulativeBeliefFusion", "cbf", "cumulativeUnfusion", "trustDiscounting", "td")
\ No newline at end of file
+__all__ = ("__doc__", "__version__", "OpinionOwner", "DirichletPDF", "MultinomialOpinion", "BinomialOpinion", "Histogram", "projectedDistance", "pd", "conjunctiveCertainty", "cc", "degreeOfConflict", "doc", "averagingBeliefFusion", "abf", "aleatoryCumulativeBeliefFusion", "cbf", "cumulativeUnfusion", "trustDiscounting", "td", "normalMultiplication", "deduction")
\ No newline at end of file
