 namespace subj {
 
+namespace {
+
+// Uncertainties below this threshold are treated as dogmatic, above 1 minus it as vacuous
+const double kUncertaintyEpsilon = 1e-12;
+
+// Handles the cases in which the belief fusion formulas are undefined (0 / 0). If any of the
+// opinions is dogmatic, the result is the average of the dogmatic opinions, which is the limit
+// of both cumulative and averaging belief fusion for equally dogmatic sources. If all opinions
+// are vacuous, the result is the vacuous opinion with the average base rate. Returns false if
+// the general fusion formulas can be applied.
+bool fuseDegenerateOpinions(const std::vector<MultinomialOpinion>& opinions,
+                            MultinomialOpinion& result)
+{
+  Eigen::Index dim           = opinions[0].dim();
+  Eigen::VectorXd b_dogmatic = Eigen::VectorXd::Zero(dim);
+  Eigen::VectorXd a_dogmatic = Eigen::VectorXd::Zero(dim);
+  Eigen::VectorXd a_sum      = Eigen::VectorXd::Zero(dim);
+  double dogmatic_count      = 0.0;
+  bool all_vacuous           = true;
+
+  for (const MultinomialOpinion& o : opinions)
+  {
+    if (o.u() < kUncertaintyEpsilon)
+    {
+      b_dogmatic += o.bMat();
+      a_dogmatic += o.aMat();
+      dogmatic_count += 1.0;
+    }
+    if (o.u() <= 1.0 - kUncertaintyEpsilon)
+    {
+      all_vacuous = false;
+    }
+    a_sum += o.aMat();
+  }
+
+  if (dogmatic_count > 0.0)
+  {
+    result.b(b_dogmatic / dogmatic_count);
+    result.u(0.0);
+    result.a(a_dogmatic / dogmatic_count);
+    return true;
+  }
+
+  if (all_vacuous)
+  {
+    result.b(Eigen::VectorXd::Zero(dim));
+    result.u(1.0);
+    result.a(a_sum / static_cast<double>(opinions.size()));
+    return true;
+  }
+
+  return false;
+}
+
+// Returns, for every opinion, the product of the uncertainties of all other opinions
+Eigen::VectorXd otherUncertaintyProducts(const std::vector<MultinomialOpinion>& opinions)
+{
+  Eigen::Index size = static_cast<Eigen::Index>(opinions.size());
+  Eigen::VectorXd u_t = Eigen::VectorXd::Ones(size);
+
+  for (Eigen::Index i = 0; i < size; ++i)
+  {
+    for (Eigen::Index j = 0; j < size; ++j)
+    {
+      if (i != j)
+      {
+        u_t[i] *= opinions[static_cast<size_t>(j)].u();
+      }
+    }
+  }
+
+  return u_t;
+}
+
+// Base rate of the fused opinion: the base rates of the sources weighted by their certainty
+// (1 - u_i) times the product of the uncertainties of all other sources
+Eigen::VectorXd fusedBaseRate(const std::vector<MultinomialOpinion>& opinions,
+                              const Eigen::VectorXd& u_t)
+{
+  Eigen::VectorXd a = Eigen::VectorXd::Zero(opinions[0].dim());
+  double weight_sum = 0.0;
+
+  for (Eigen::Index i = 0; i < u_t.size(); ++i)
+  {
+    const MultinomialOpinion& o = opinions[static_cast<size_t>(i)];
+    double weight               = (1.0 - o.u()) * u_t[i];
+    a += weight * o.aMat();
+    weight_sum += weight;
+  }
+
+  return a / weight_sum;
+}
+
